def redrawAll(app):
    # event - master draw, dispatches per state
    drawBackground(app)
    if app.state == 'menu':
        drawMenuScreen(app)
    elif app.state == 'pick':
        drawPickScreen(app)
    elif app.state == 'battle':
        drawBattleScreen(app)
    elif app.state == 'roster':
        drawRosterScreen(app)
    # particles drawn last so they appear on top
    i = 0
    while i < len(app.particles):
        p = app.particles[i]
        op = max(20, min(100, p['life'] * 5))
        drawCircle(p['x'], p['y'], p['r'], fill=p['color'], opacity=op)
        i += 1

def drawBackground(app):
