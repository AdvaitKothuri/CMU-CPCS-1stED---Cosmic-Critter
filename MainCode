    drawRect(0,0,400,400,fill=rgb(8,12,35))
    drawRect(0,0,400,90,fill=rgb(20,25,60), opacity = 40)
    
    i=40
    while i<len(app.stars):
        sx,sy,ph = app.stars[i]
        b = (app.tick + ph) % 60
        op = 30 + b*2 if b<30 else 90 - (b-30)*2
        drawCircle(sx,sy,1,fill='white', opacity=op)
        i +=1
        
