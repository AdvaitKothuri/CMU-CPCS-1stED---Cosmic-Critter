def drawCritterSprite(app, name, cx, cy, scale=1.0, shakeX=0, shakeY=0
                    , faceDir=0):
    
    # function - DICTIONARY OUTPUT. 
    #Reads stats from app.critters via 
    #.get() and draws a sprite whose body color and type-themed glow  
    #ring come from the dict.
    
    s = app.critters.get(name)
    if s is None:
        return
    bodyR = 28 * scale
    px = cx + shakeX
    py = cy + shakeY
    
    # type-themed ring color
    typeRings = {'Light': 'gold', 'Shadow': 'purple', 'Fire': 'orange'
                , 'Ice': 'cyan', 'Cosmic': 'mediumPurple'}
    ring = typeRings.get(s['type'], 'white')
    drawCircle(px, py, bodyR + 12, fill='white', opacity=10)
    drawCircle(px, py, bodyR + 7, fill=None, border=ring, borderWidth=2
            , opacity=70)
    drawCircle(px, py, bodyR, fill=s['color'], border='white'
            , borderWidth=2)
    
    # eyes
    eX = 9 * scale
    eY = py - 4 * scale
    drawCircle(px - eX, eY, 5*scale, fill='white')
    drawCircle(px + eX, eY, 5*scale, fill='white')
    pdx = faceDir * 2 * scale
    drawCircle(px - eX + pdx, eY, 2.5*scale, fill='black')
    drawCircle(px + eX + pdx, eY, 2.5*scale, fill='black')
    
    # mouth
    drawOval(px, py + 9*scale, 10*scale, 3*scale, fill='black')

def drawHPBar(x, y, w, h, hp, maxHP):
    # helper - bordered HP bar; green/gold/red by ratio
    ratio = hp / maxHP if maxHP > 0 else 0
    if ratio < 0:
        ratio = 0
    if ratio > 1:
        ratio = 1
    if ratio > 0.5:
        c = 'lime'
    elif ratio > 0.25:
        c = 'gold'
    else:
        c = 'red'
    drawRect(x, y, w, h, fill='black', border='white', borderWidth=1)
    if ratio > 0:
        drawRect(x+1, y+1, ratio * (w-2), h-2, fill=c)
    
def drawButton(x, y, w, h, label, fillColor):
    # helper - labeled button with white border
    drawRect(x, y, w, h, fill=fillColor, border='white', borderWidth=1)
    drawLabel(label, x + w/2, y + h/2, size=12, bold=True, fill='white')
    
def getCurrentRosterName(app):
    # helper - current roster critter name or None
    if len(app.critterNames) == 0:
        return None
    if app.rosterIndex >= len(app.critterNames):
        app.rosterIndex = len(app.critterNames) - 1
    return app.critterNames[app.rosterIndex]
    
def processStat(rawText):
    # helper - INPUT PROCESSING. Returns int >= 0 or 
    #None if blank/cancelled/contains non-digits.
    
    if rawText is None:
        return None
    cleaned = rawText.strip()
    if cleaned == '':
        return None
    for ch in cleaned:
        if ch < '0' or ch > '9':
            return None
    return int(cleaned)
    
def calculateDamage(a, d):
    # helper - simple damage = atk - def//2 (min 1)
    dmg = a['atk'] - d['def'] // 2
    return dmg if dmg > 1 else 1
    
def addLog(app, msg):
    # function - append a log line, keep last 3
    app.battleLog.append(msg)
    while len(app.battleLog) > 3:
        app.battleLog.pop(0)
        
def spawnParticles(app, cx, cy, color):
    # function - 10 particles flying outward
    i = 0
    while i < 10:
        app.particles.append({'x': cx, 'y': cy, 'dx': random.uniform(-4, 4)
                            , 'dy': random.uniform(-4, -1)
                            , 'life': 18 + random.randint(0, 6)
                            , 'r': random.randint(2, 4), 'color': color})
        i += 1
    
# functions

def goToMenu(app):
    # function - return to menu
    app.state = 'menu'
    app.statusMsg = ''
    
def confirmFighter(app):
    # function - lock in pick + start battle vs random
    if len(app.critterNames) == 0:
        return
    pn = app.critterNames[app.pickerIndex]
    pool = [n for n in app.critterNames if n != pn]
    on = pn if len(pool) == 0 else random.choice(pool)
    ps = app.critters[pn]
    os = app.critters[on]
    app.playerName = pn
    app.playerHP = ps['hp']
    app.playerMaxHP = ps['hp']
    app.opponentName = on
    app.opponentHP = os['hp']
    app.opponentMaxHP = os['hp']
    app.battleTurn = 'player'
    app.battleLog = ['A wild ' + on + ' appeared!']
    app.battleLockFrames = 0
    app.battleOver = False
    app.battleResult = None
    app.healsLeft = 2
    app.particles = []
    app.state = 'battle'
    
    
def playerAttack(app):
    # function - player attacks opponent
    
    if app.battleTurn != 'player' or app.battleLockFrames > 0:
        return
    if app.battleOver:
        return
    a = app.critters[app.playerName]
    d = app.critters[app.opponentName]
    dmg = calculateDamage(a, d)
    app.opponentHP = max(0, app.opponentHP - dmg)
    app.opponentShake = 8
    spawnParticles(app, 290, 95, d['color'])
    addLog(app, f'{app.playerName} attacks for {dmg} damage!')
    if app.opponentHP <= 0:
        endBattle(app, 'win')
        return
    app.battleTurn = 'opponent'
    app.battleLockFrames = 30
    
def playerHeal(app):
    # function - heal 25 HP if uses remain
    if app.battleTurn != 'player' or app.battleLockFrames > 0:
        return
    if app.battleOver:
        return
    if app.healsLeft <= 0:
        addLog(app, 'No heals left!')
        return
    app.playerHP = min(app.playerMaxHP, app.playerHP + 25)
    app.healsLeft -= 1
    addLog(app, app.playerName + ' heals for 25 HP.')
    app.battleTurn = 'opponent'
    app.battleLockFrames = 30
    
def opponentTurn(app):
    # function - opponent's automatic attack
    if app.battleOver:
        return
    a = app.critters[app.opponentName]
    d = app.critters[app.playerName]
    dmg = calculateDamage(a, d)
    app.playerHP = max(0, app.playerHP - dmg)
    app.playerShake = 8
    spawnParticles(app, 110, 200, d['color'])
    addLog(app, app.opponentName + ' attacks for ' + str(dmg) + ' damage!')
    if app.playerHP <= 0:
        endBattle(app, 'lose')
        return
    app.battleTurn = 'player'
    app.battleLockFrames = 15
    
def fleeBattle(app):
    # function - escape battle
    addLog(app, 'You fled the battle.')
    endBattle(app, 'flee')
    
def endBattle(app, result):
    # function - mark battle done + update records
    app.battleOver = True
    app.battleResult = result
    if result == 'win':
        app.wins += 1
        addLog(app, 'You won!')
    elif result == 'lose':
        app.losses += 1
        addLog(app, 'You were defeated...')
        
def addCritter(app):
    # function - DICTIONARY INPUT. Prompt for each field via getTextInput 
    #dialogs and insert into the dict.
    name = app.getTextInput('New critter name:')
    if name is None or name.strip() == '':
        return
    name = name.strip()
    if name in app.critters:
        app.statusMsg = '"' + name + '" already exists.'
        return
    cType = app.getTextInput('Type? (Cosmic/Shadow/Light/Ice/Fire)')
    if cType is None or cType.strip() == '':
        cType = 'Cosmic'
    hp = processStat(app.getTextInput('HP (whole #):'))
    if hp is None or hp == 0:
        app.statusMsg = 'Invalid HP -- cancelled.'
        return
    atk = processStat(app.getTextInput('ATK (whole #):'))
    if atk is None:
        app.statusMsg = 'Invalid ATK -- cancelled.'
        return
    deff = processStat(app.getTextInput('DEF (whole #):'))
    if deff is None:
        app.statusMsg = 'Invalid DEF -- cancelled.'
        return
    color = app.getTextInput('Color (e.g. pink, gold):')
    if color is None or color.strip() == '':
        color = 'white'
        color = color.strip()
    if color not in app.validColors:
        app.statusMsg = '"' + color + '" not valid color.'
        return
    app.critters[name] = {'type': cType.strip(), 'hp': hp, 'atk': atk
                        , 'def': deff, 'color': color}
    app.critterNames.append(name)
    app.rosterIndex = len(app.critterNames) - 1
    app.statusMsg = 'Added "' + name + '"!'
    app.state = 'roster'
    
    
def searchCritter(app):
    # function - USES .get() for safe lookup by name.
    query = app.getTextInput('Search for which critter?')
    if query is None:
        return
    query = query.strip()
    
    # KEY .get() LINE -- None if missing
    found = app.critters.get(query)
    if found is None:
        app.statusMsg = '"' + query + '" not found.'
        app.state = 'roster'
        return
    app.rosterIndex = app.critterNames.index(query)
    app.statusMsg = 'Found ' + query + ' (' + found['type'] + ' type)!'
    app.state = 'roster'
    
def modifyCritter(app):
    # function - DICTIONARY MODIFICATION.
    #Update one field on the current roster critter.
    name = getCurrentRosterName(app)
    if name is None:
        return
    field = app.getTextInput('Which stat? (hp/atk/def/color)')
    if field is None:
        return
    field = field.strip().lower()
    if field not in ['hp', 'atk', 'def', 'color']:
        app.statusMsg = 'Pick hp, atk, def, or color.'
        return
    newVal = app.getTextInput('New value for ' + field + ':')
    if newVal is None:
        return
    if field == 'color':
        c = newVal.strip()
        if c not in app.validColors:
            app.statusMsg = '"' + c + '" not valid color.'
            return
        app.critters[name]['color'] = c
    else:
        parsed = processStat(newVal)
        if parsed is None:
            app.statusMsg = 'Invalid number.'
            return
        app.critters[name][field] = parsed
    app.statusMsg = 'Updated ' + field + ' on ' + name + '.'
    
def deleteCritter(app):
    # function - confirm-and-remove from dict
    name = getCurrentRosterName(app)
    if name is None:
        return
    confirm = app.getTextInput('Type YES to delete "' + name + '":')
    if confirm is None or confirm.strip().upper() != 'YES':
        app.statusMsg = 'Delete cancelled.'
        return
    app.critters.pop(name)
    app.critterNames.remove(name)
    if app.rosterIndex >= len(app.critterNames):
        app.rosterIndex = max(0, len(app.critterNames) - 1)
    app.statusMsg = 'Deleted ' + name + '.'
    
# events

def onMousePress(app, mouseX, mouseY):
    # event - state-aware click router
    x, y = mouseX, mouseY
    if app.state == 'menu':
        if 100 <= x <= 300:
            if 170 <= y <= 208 and len(app.critterNames) > 0:
                app.pickerIndex = 0
                app.state = 'pick'
                
            elif 215 <= y <= 253:
                app.state = 'roster'
                app.statusMsg = ''
                
            elif 260 <= y <= 298:
                addCritter(app)
                
            elif 305 <= y <= 343:
                searchCritter(app)
                
    elif app.state == 'pick':
        n = len(app.critterNames)
        if 20 <= x <= 50 and 130 <= y <= 180 and n > 0:
            app.pickerIndex = (app.pickerIndex - 1) % n
        elif 350 <= x <= 380 and 130 <= y <= 180 and n > 0:
            app.pickerIndex = (app.pickerIndex + 1) % n
        elif 110 <= x <= 290 and 295 <= y <= 333:
            confirmFighter(app)
        elif 140 <= x <= 260 and 345 <= y <= 375:
            goToMenu(app)
    elif app.state == 'battle':
        if app.battleOver:
            if 125 <= x <= 275 and 350 <= y <= 385:
                goToMenu(app)
            return
        if app.battleTurn != 'player' or app.battleLockFrames > 0:
            return
        if 350 <= y <= 385:
            if 15 <= x <= 120:
                playerAttack(app)
            elif 130 <= x <= 235:
                playerHeal(app)
            elif 245 <= x <= 315:
                fleeBattle(app)
    elif app.state == 'roster':
        n = len(app.critterNames)
        if 20 <= x <= 50 and 130 <= y <= 180 and n > 0:
            app.rosterIndex = (app.rosterIndex - 1) % n
        elif 165 <= x <= 195 and 130 <= y <= 180 and n > 0:
            app.rosterIndex = (app.rosterIndex + 1) % n
        elif 280 <= y <= 315:
            if 20 <= x <= 130:
                modifyCritter(app)
            elif 140 <= x <= 250:
                deleteCritter(app)
            elif 260 <= x <= 380:
                goToMenu(app)
             
def onMouseMove(app, mouseX, mouseY):
    # event - tracks mouse position
    app.mouseX = mouseX
    app.mouseY = mouseY

             
def onKeyPress(app, key):
    # event - keyboard shortcuts (Esc/B + arrows)
    if key == 'escape' or key == 'b':
        if app.state != 'menu':
            goToMenu(app)
        return
    n = len(app.critterNames)
    if n == 0:
        return
    if app.state == 'pick':
        if key == 'left':
            app.pickerIndex = (app.pickerIndex - 1) % n
        elif key == 'right':
            app.pickerIndex = (app.pickerIndex + 1) % n
    elif app.state == 'roster':
        if key == 'left':
            app.rosterIndex = (app.rosterIndex - 1) % n
        elif key == 'right':
            app.rosterIndex = (app.rosterIndex + 1) % n

def onStep(app):
    # event - per-frame: anim tick, particles, shakes, opponent's delayed turn
    app.tick += 1
    # update particles
    keep = []
    i = 0
    while i < len(app.particles):
        p = app.particles[i]
        p['x'] += p['dx']
        p['y'] += p['dy']
        p['dy'] += 0.3
        p['life'] -= 1
        if p['life'] > 0:
            keep.append(p)
        i += 1
    app.particles = keep
    # decay shakes
    if app.playerShake > 0:
        app.playerShake -= 1
    if app.opponentShake > 0:
        app.opponentShake -= 1
    # opponent's delayed turn
    if app.battleLockFrames > 0:
        app.battleLockFrames -= 1
        if app.battleLockFrames == 0 :
            if app.state == 'battle':
                if app.battleTurn == 'opponent' and not app.battleOver:
                    opponentTurn(app)

def main():
    runApp()
    
main()
